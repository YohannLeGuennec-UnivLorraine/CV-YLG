---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  {% assign posts_by_date = site.pages | where: "blog_post", true | sort: "date" | reverse %}
  <title>Blog de Yohann Le Guennec</title>
  <link href="{{ site.url }}{{ site.baseurl }}/blog/feed.xml" rel="self" />
  <link href="{{ site.url }}{{ site.baseurl }}/blog/" />
  <updated>{% if posts_by_date.first %}{{ posts_by_date.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/blog/</id>
  <author><name>Yohann Le Guennec</name></author>
  {% for post in posts_by_date limit:20 %}
    <entry>
      <title>{{ post.title | xml_escape }}</title>
      <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}" />
      <updated>{{ post.date | date_to_xmlschema }}</updated>
      <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
      <summary>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
    </entry>
  {% endfor %}
</feed>
